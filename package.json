{
  "name": "test-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:tests": "tsx apps/admin/src/catalog/check.ts",
    "check:spec": "node .claude/scripts/check-spec-refs.mjs",
    "check:workflow": "node --test .claude/scripts/*.test.mjs",
    "smoke": "tsx apps/admin/src/smoke.ts"
  },
  "dependencies": {
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^8.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
