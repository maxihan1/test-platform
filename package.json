{
  "name": "test-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:always": "vitest run apps/admin/src/app.test.ts apps/admin/src/auth/gate.test.ts apps/admin/src/auth/scope.test.ts apps/admin/src/deploy.test.ts apps/admin/src/reporting/dashboard.test.ts apps/admin/src/reporting/dashboard-authoring.test.ts apps/admin/src/web/jsxEnv.test.ts apps/admin/src/web/messages.test.ts apps/admin/src/web/styles.test.ts scripts/authoring-address.test.ts",
    "check:tests": "tsx apps/admin/src/catalog/check.ts",
    "check:spec": "node .claude/scripts/check-spec-refs.mjs",
    "check:docs-contract": "node --test .claude/scripts/cases-probe-contract.test.mjs",
    "check:secret-names": "node .claude/scripts/check-secret-names.mjs",
    "check:evidence-formats": "node --test .claude/scripts/check-evidence-formats.test.mjs",
    "check:workflow": "node --test .claude/scripts/*.test.mjs",
    "check:deps": "node .claude/scripts/check-deps.mjs",
    "count:done": "awk '/^[[:space:]]*- \\[[xX]\\]/{x++} /^[[:space:]]*- \\[ \\]/{o++} END{printf \"완료 기준 %d개 · 확인 끝난 것 %d개 · 남은 것 %d개\\n\", x+o, x, o}' docs/spec/공통/7-데모와-완료.md",
    "smoke": "tsx apps/admin/src/smoke.ts",
    "authoring-agent": "tsx scripts/authoring-agent.ts"
  },
  "dependencies": {
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^8.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "jszip": "^3.10.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
