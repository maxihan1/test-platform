// scripts/kit-release.ts 만 쓴다 — 그 스크립트가 원본을 build/kit/src 에 옮긴 뒤 이 설정으로 빌드한다(SETUP §21)
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "../../build/kit/src",
    "outDir": "../../build/kit/dist"
  },
  "include": ["../../build/kit/src/**/*.ts"]
}
