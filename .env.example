# 이 파일을 .env 로 복사해 값을 채운다 (SPEC §9).
# .env 는 저장소에 올리지 않는다 — .gitignore 에 이미 들어 있다.

# 로그인 세션을 서명하는 키. 비우면 admin 이 기동을 거부한다.
# 아무 긴 무작위 문자열이면 된다. 예: openssl rand -hex 32
SESSION_SECRET=

# 바깥 포트. 비우면 아래 기본값으로 뜬다.
# 한 서버에 다른 것과 같이 띄울 때만 바꾼다.
# Grafana 는 바깥 포트가 없다 — admin 의 /grafana/ 로 연다.
ADMIN_PORT=3000
POSTGRES_PORT=5433

# 이 플랫폼이 바깥에서 열리는 주소. Slack 알림의 「결과 보기」 링크가 이 값 위에 붙는다.
# 비워 두면 알림에 링크가 들어가지 않는다. 예: https://qa-platform.사내주소
PLATFORM_PUBLIC_URL=

# 작성 에이전트(서버 author · 맥은 대체)가 쓰는 계정 아이디.
# 비워 두면 **아무도 작성 요청을 집어가지 못한다** — 열어 두면 그 서비스에 배정된 아무
# 실행 등급 계정이 에이전트보다 먼저 집어 병합될 PR 주소를 자기 것으로 바꿔치기할 수 있다.
# 그 계정은 operator 여야 한다. admin 을 주면 그 계정 하나가 설정 화면 전부를 연다.
#
# 에이전트 토큰은 이 계정에만 발급된다 (설정 > 계정).
AUTHORING_AGENT_USER=

# ── 작성 에이전트 컨테이너(author) — 선택 사항 (docs/SETUP.md §8) ──────────────────────
# 셋 다 채운 뒤 `docker compose --profile authoring up -d author` 로 켠다. 이 파일은 컨테이너 안에서 가린다.
#
# 설정 > 계정 > 위 계정 > 에이전트 토큰 [발급] 값 (tpa_…)
AUTHORING_AGENT_TOKEN=
# 아무 기계에서 `claude setup-token` 을 치면 나오는 구독 토큰 (sk-ant-oat…). API 키를 넣으면 실비 청구라 켜지지 않는다.
# 고객사 서버에는 그 회사 Claude 계정으로 만든 토큰을 넣는다 — 개인 구독 토큰을 심지 않는다
CLAUDE_CODE_OAUTH_TOKEN=
# (선택) 월간 API 크레딧을 받은 Console 조직의 API 키 (sk-ant-…, 구독 토큰 sk-ant-oat… 아님). 크레딧 먼저 쓰고 떨어지면 구독으로 넘어간다.
# 그 조직에 결제 수단 · 자동 충전이 없어야 추가 청구가 없다 (docs/SETUP.md 「API 크레딧 먼저 쓰기」)
AUTHORING_CREDIT_KEY=
# PR 열기·초안 풀기·병합 권한만 준 GitHub 토큰 (fine-grained: Contents·Pull requests 읽기/쓰기)
GH_TOKEN=
# 서버 저장소 주인의 uid:gid (리눅스 `id -u` · `id -g`). 서버 저장소에 쓰는 일은 이 계정으로 한다. 비우면 1000
HOST_UID=
HOST_GID=
# 자식 claude 의 uid. 자리 k 는 이 값 + k. 0 이나 HOST_UID 와 겹치면 켜지지 않는다. 비우면 20000
AUTHORING_CHILD_UID=
# 동시에 도는 작성 수. 늘리면 docker-compose.yml 의 author mem_limit 도 한 건 4g 씩 늘린다. 비우면 2
AUTHORING_MAX_PARALLEL=
# 작성 메인 모델 · 생각 깊이(low·medium·high·xhigh·max) · 예비 모델(과부하·미제공일 때만, none 이면 끈다). 비우면 claude-opus-5-5 · high · sonnet (2026-10-04)
# 보조(화면 훑기 · 케이스 작성)는 .claude/agents/author-scan.md · author-write.md 가 정한다
AUTHORING_MODEL=
AUTHORING_EFFORT=
AUTHORING_FALLBACK_MODEL=
# Claude CLI 를 켤 때와 하루 한 번 올린다(점검 실패면 직전 판). 판은 stable · latest · x.y.z. 끄려면 AUTOUPDATE=0
AUTHORING_CLAUDE_AUTOUPDATE=
AUTHORING_CLAUDE_VERSION=

# 맥에서 에이전트를 직접 돌릴 때(개발용 대체)만 쓴다. admin 이 다른 기계에 있으면 그 주소. 비우면 http://localhost:3000.
# 서버 컨테이너는 compose 가 http://admin:3000 으로 채운다
PLATFORM_ADMIN_URL=

# 케이스 "테스트 실행"과 Android 앱 정식 실행이 쓸 러너 주소(관리 서버와 같은 기계). 비우면 꺼진다. 켜는 법은 docs/SETUP.md "내 컴퓨터 러너"
# 예) http://host.docker.internal:4001
LOCAL_RUNNER_URL=

# 스크린샷 · 증적 문서를 둘 자리. 비우면 이름 붙은 볼륨(운영 서버는 이대로 둔다).
# Android 앱 정식 실행을 쓰는 맥은 ./artifacts 로 적는다 — 위 러너가 쓰는 폴더를 컨테이너도 본다
PLATFORM_ARTIFACTS_VOLUME=
