#!/usr/bin/env bash
set -e
echo "[pre-push] 검사 시작"

if [ -f package.json ]; then
  if ! npm test --silent; then
    echo ""
    echo "[차단] 테스트가 실패했다. 고치고 다시 푸시해라." >&2
    exit 1
  fi

  if ! npm run check:tests --if-present --silent; then
    echo "" >&2
    echo "[차단] 테스트 코드 규칙 위반 (SPEC §4 K1~K8). 위 메시지대로 고치고 다시 푸시해라." >&2
    exit 1
  fi
else
  echo "[pre-push] package.json이 없다 (Phase 0 전). 테스트 검사는 건너뛴다."
fi

if [ "$ALLOW_PROTECTED" = "1" ]; then
  echo "[pre-push] ALLOW_PROTECTED=1 (Phase 0 또는 병합 단계). 검사 기록 확인은 건너뛴다."
  echo "[pre-push] 통과"
  exit 0
fi

TODAY=$(date +%F)
if ! ls docs/reviews/${TODAY}-*.md >/dev/null 2>&1; then
  echo "" >&2
  echo "[차단] 오늘 날짜의 SPEC 검사 기록이 없다: docs/reviews/${TODAY}-*.md" >&2
  echo "" >&2
  echo "Claude Code에서 spec-review 스킬을 돌리고 결과를 저장한 뒤 푸시해라." >&2
  echo "정말 건너뛰어야 하면: git push --no-verify" >&2
  exit 1
fi

echo "[pre-push] 통과"
