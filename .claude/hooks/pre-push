#!/usr/bin/env bash
# 푸시 전 검사. 저장소 안에 두는 이유 — .git/hooks 는 추적이 안 돼 PR 에 안 실리고
# 판별식이 못 보고 새 기계에서 사라진다. 배선은 로컬이다 (docs/SETUP.md).
set -e

# ── 삭제 push 는 바로 통과한다 ────────────────────────────────────────────
# git 이 stdin 으로 줄마다 `<로컬 ref> <로컬 sha> <원격 ref> <원격 sha>` 를 준다.
# 삭제는 로컬 sha 가 전부 0 이다. 코드를 안 올리므로 검사할 것이 없다.
#
# ★ stdin 은 **한 번만 읽힌다.** 여기서 다 읽어 변수에 담고, 아래 검사는 stdin 을
#   쓰지 않는다. 뒤에서 또 읽으려 하면 빈 값을 받는다.
# ★ 입력이 비면 **검사로 간다.** 삭제로 보면 검사가 새어 나간다 (보수적).
#
# 2026-09-18 — 원격 브랜치 여섯을 지우면서 전체 테스트가 여섯 번 돌았다.
# 변수명은 ASCII 로 둔다 — bash 는 한글 변수명을 받지 않는다 (2026-09-18 실측)
REFS=$(cat)
if [ -n "$REFS" ]; then
  only_deletes=1
  while IFS=' ' read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$local_sha" in
      *[!0]*) only_deletes=0; break ;;
    esac
  done <<EOF
$REFS
EOF
  if [ "$only_deletes" = "1" ]; then
    echo "[pre-push] 브랜치 삭제다. 올릴 코드가 없으므로 검사를 건너뛴다"
    exit 0
  fi
fi

echo "[pre-push] 검사 시작"

# ── 차선 판정 — 바뀐 만큼만 검사한다 ─────────────────────────────────────
# docs(문서만) · spec(명세 포함) · cases(테스트만) · full(그 밖). 정본 docs/HOOKS.md 「차선」.
# 판정 규칙은 lane.mjs 한 곳에 있다 — 훅에 복사하지 않는다.
# 원격 sha 는 새 브랜치면 0 이라 쓰지 않고, 늘 origin/main 과 견준다. 삭제 줄은 건너뛴다.
# --no-renames — 켜 두면 apps/x.ts 를 tests/todo/x.spec.ts 로 옮긴 것이 새 경로 하나로만 나와 가벼운 길로 샌다.
# 어느 ref 든 git diff 가 실패하면 full 이다 (보수적). 입력이 비어도 full 이다.
# ref 마다 차선이 다르면 full 이다.
#
# diff 가 **성공했는데 비었으면** 그 ref 는 올릴 파일이 없다 — 빈 시작 커밋(tpx-start)이 그렇다.
# 이것을 full 로 보내 그날 첫 push 가 검사 기록 요구에 막힌 일이 세 번 났다 (LEARNINGS 09-23 · 09-24 · 09-25).
# 「못 읽었다」와 「읽었더니 없다」는 다르다 — 앞엣것만 full 이다.
LANE_JS="$(dirname "$0")/../scripts/lane.mjs"
lane=""
changed_all=""
if [ -n "$REFS" ]; then
  while IFS=' ' read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$local_sha" in
      *[!0]*) ;;
      *) continue ;;
    esac
    changed=$(git -c core.quotePath=false diff --no-renames --name-only "origin/main...$local_sha" 2>/dev/null) || { lane=full; break; }
    [ -z "$changed" ] && continue
    changed_all="$changed_all
$changed"
    this=$(printf '%s\n' "$changed" | node "$LANE_JS" origin/main | sed -n 's/^lane=//p')
    [ -z "$this" ] && this=full
    if [ -z "$lane" ]; then lane=$this; elif [ "$lane" != "$this" ]; then lane=full; fi
  done <<EOF
$REFS
EOF
  if [ -z "$lane" ]; then
    echo "[pre-push] 바뀐 파일이 없다 (빈 커밋). 검사를 건너뛴다"
    exit 0
  fi
else
  lane=full
fi
echo "[pre-push] 차선: $lane"

if [ "$lane" = "docs" ] || [ "$lane" = "spec" ]; then
  # check:spec 은 node 표준 모듈만 쓴다 — 문서 PR 에 테스트·타입 검사가 볼 것이 없다
  if ! npm run check:spec --silent; then
    echo "" >&2
    echo "[차단] SPEC 문서 검사 실패 (없는 절·깨진 링크·색인 분량). 위 메시지대로 고치고 다시 푸시해라." >&2
    exit 1
  fi
  # 문서 내용을 읽는 판별식 — check:workflow 를 안 도는 차선이라 여기서 돈다
  if ! npm run check:docs-contract --silent; then
    echo "" >&2
    echo "[차단] 문서 계약 검사 실패. 위 메시지대로 고치고 다시 푸시해라." >&2
    exit 1
  fi
  if [ "$lane" = "docs" ]; then
    echo "[pre-push] 문서만 바뀌었다 (docs 차선). 통과"
    exit 0
  fi
  # spec 은 아래 검사 기록(spec-review) 확인으로 간다
fi

if [ "$lane" = "cases" ]; then
  echo "[pre-push] 테스트만 바뀌었다 (가벼운 길) — 타입 검사와 테스트 코드 규칙만 돈다. 전체 단위 테스트와 검사 기록 요구는 건너뛴다"
  if ! npm run typecheck --silent; then
    echo "" >&2
    echo "[차단] 타입 검사가 실패했다. 고치고 다시 푸시해라." >&2
    exit 1
  fi
  # --if-present 를 안 붙인다 — 가벼운 길의 유일한 규칙 검사라 스크립트가 사라지면 조용히 통과하지 말고 죽어야 한다
  if ! npm run check:tests --silent; then
    echo "" >&2
    echo "[차단] 테스트 코드 규칙 위반 (SPEC §4 K표). 위 메시지대로 고치고 다시 푸시해라." >&2
    exit 1
  fi
  echo "[pre-push] 통과"
  exit 0
fi

if [ "$lane" = "spec" ]; then
  :
elif [ -f package.json ]; then
  # 바뀐 것과 이어진 검사만 돈다 (vitest --changed) + import 로 안 이어지는 검사(test:always).
  # 다만 migration · 설정이 바뀌면 전체다. vitest 의 forceRerunTriggers 가 그 일을 하지만
  # 경로에 점 폴더(.claude/worktrees)가 끼면 안 걸린다 — 작업방에서 푸시하는 이 훅은 거기에 기댈 수 없다
  if printf '%s\n' "$changed_all" | grep -qE '^(db/|package(-lock)?\.json$|vitest\.config\.|tsconfig)'; then
    if ! npm test --silent; then
      echo ""
      echo "[차단] 테스트가 실패했다. 고치고 다시 푸시해라." >&2
      exit 1
    fi
  elif ! { npm run test:changed --silent -- origin/main && npm run test:always --silent; }; then
    echo ""
    echo "[차단] 테스트가 실패했다. 고치고 다시 푸시해라." >&2
    exit 1
  fi

  if ! npm run check:tests --if-present --silent; then
    echo "" >&2
    echo "[차단] 테스트 코드 규칙 위반 (SPEC §4 K표). 위 메시지대로 고치고 다시 푸시해라." >&2
    exit 1
  fi
else
  echo "[pre-push] package.json이 없다 (Phase 0 전). 테스트 검사는 건너뛴다."
fi

if [ "$ALLOW_PROTECTED" = "1" ]; then
  echo "[pre-push] ALLOW_PROTECTED=1 (Phase 0 또는 병합 단계). 검사 기록 확인은 건너뛴다."
  echo "[pre-push] 통과"
  exit 0
fi

TODAY=$(date +%F)
if ! ls docs/reviews/${TODAY}-*.md >/dev/null 2>&1; then
  echo "" >&2
  echo "[차단] 오늘 날짜의 SPEC 검사 기록이 없다: docs/reviews/${TODAY}-*.md" >&2
  echo "" >&2
  echo "Claude Code에서 spec-review 스킬을 돌리고 결과를 저장한 뒤 푸시해라." >&2
  echo "정말 건너뛰어야 하면: git push --no-verify" >&2
  exit 1
fi

echo "[pre-push] 통과"
