#!/usr/bin/env bash
# 푸시 전 검사. 저장소 안에 두는 이유 — .git/hooks 는 추적이 안 돼 PR 에 안 실리고
# 판별식이 못 보고 새 기계에서 사라진다. 배선은 로컬이다 (docs/SETUP.md).
# 사람 PR 에는 CI 가 없다(2026-10-09 — 서비스 전 · 혼자 작업). 그래서 이 훅이 유일한 자동 검사다.
set -e

# ── 삭제 push 는 바로 통과한다 ────────────────────────────────────────────
# git 이 stdin 으로 줄마다 `<로컬 ref> <로컬 sha> <원격 ref> <원격 sha>` 를 준다.
# 삭제는 로컬 sha 가 전부 0 이다. 코드를 안 올리므로 검사할 것이 없다.
#
# ★ stdin 은 **한 번만 읽힌다.** 여기서 다 읽어 변수에 담고, 아래 검사는 stdin 을 쓰지 않는다.
# ★ 입력이 비면 **검사로 간다.** 삭제로 보면 검사가 새어 나간다 (보수적).
# 변수명은 ASCII 로 둔다 — bash 는 한글 변수명을 받지 않는다
REFS=$(cat)
SHAS=""
if [ -n "$REFS" ]; then
  while IFS=' ' read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$local_sha" in
      *[!0]*) SHAS="$SHAS $local_sha" ;;
    esac
  done <<EOF
$REFS
EOF
  if [ -z "$SHAS" ]; then
    echo "[pre-push] 브랜치 삭제다. 올릴 코드가 없으므로 검사를 건너뛴다"
    exit 0
  fi
fi

echo "[pre-push] 검사 시작"

# ── git 이 넣어 준 GIT_* 를 걷는다 ──────────────────────────────────────────
# 훅 안에서는 GIT_DIR 등이 이 저장소를 가리킨다. 검사가 임시 폴더에 git 저장소를 만들 때 그 값을 물려받으면
# 임시 폴더가 아니라 **이 저장소**에 커밋하고 core.bare=true 를 박는다 (2026-09-24 · 09-25 두 번).
for v in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done

# ── 차선 판정 — 바뀐 만큼만 검사한다 ─────────────────────────────────────
# docs(문서만) · spec(명세 포함) · cases(테스트만) · full(그 밖). 판정 규칙은 lane.mjs 한 곳에 있다.
# 원격 sha 는 새 브랜치면 0 이라 쓰지 않고, 늘 origin/main 과 견준다.
# --no-renames — 켜 두면 apps/x.ts 를 tests/todo/x.spec.ts 로 옮긴 것이 새 경로 하나로만 나와 가벼운 길로 샌다.
# git diff 가 실패하면 full · 입력이 비어도 full · ref 마다 차선이 다르면 full 이다.
# diff 가 성공했는데 비었으면(빈 시작 커밋) 올릴 파일이 없다 — 「못 읽었다」만 full 이다.
LANE_JS="$(dirname "$0")/../scripts/lane.mjs"
lane=""
changed_all=""
if [ -n "$REFS" ]; then
  for local_sha in $SHAS; do
    changed=$(git -c core.quotePath=false diff --no-renames --name-only "origin/main...$local_sha" 2>/dev/null) || { lane=full; break; }
    [ -z "$changed" ] && continue
    changed_all="$changed_all
$changed"
    this=$(printf '%s\n' "$changed" | node "$LANE_JS" origin/main | sed -n 's/^lane=//p')
    [ -z "$this" ] && this=full
    if [ -z "$lane" ]; then lane=$this; elif [ "$lane" != "$this" ]; then lane=full; fi
  done
  if [ -z "$lane" ]; then
    echo "[pre-push] 바뀐 파일이 없다 (빈 커밋). 검사를 건너뛴다"
    exit 0
  fi
else
  lane=full
fi
echo "[pre-push] 차선: $lane"

fail() {
  echo "" >&2
  echo "[차단] $1 고치고 다시 푸시해라." >&2
  exit 1
}

if [ "$lane" = "docs" ] || [ "$lane" = "spec" ]; then
  # check:spec 은 node 표준 모듈만 쓴다 — 문서 PR 에 테스트·타입 검사가 볼 것이 없다
  npm run check:spec --silent || fail "SPEC 문서 검사 실패 (없는 절·깨진 링크·색인 분량)."
  echo "[pre-push] 통과"
  exit 0
fi

npm run typecheck --silent || fail "타입 검사가 실패했다."

if [ "$lane" = "full" ]; then
  # ── 서버 · DB 코드가 바뀌었으면 임시 DB 에서 DB 검사도 돈다 ──────────────────
  # 사람 PR 에 CI 가 없어 DB 검사는 여기서만 돈다 (2026-10-09 사용자). DATABASE_URL 이 없으면 DB 검사는 조용히 건너뛰므로
  # 개발 postgres(docker compose 의 5433)에 임시 DB 를 만들어 넘긴다. 평소 쓰는 platform DB 에는 새 마이그레이션을 안 건다 (SETUP §13).
  # 못 붙으면 막는다 — 건너뛰면 초록이 거짓말을 한다
  # 전체를 다시 도는 설정 파일(아래 npm test 조건)이 바뀌어도 DB 검사가 같이 돌아야 한다
  if printf '%s\n' "$changed_all" | grep -v '^apps/admin/src/web/' | grep -qE '^(apps/|packages/|scripts/|db/|package(-lock)?\.json$|vitest\.config\.|tsconfig)'; then
    DB_NAME="tp_prepush_$$"
    export PGPASSWORD=platform
    psql -h 127.0.0.1 -p 5433 -U platform -d postgres -qc "CREATE DATABASE $DB_NAME" >/dev/null 2>&1 \
      || fail "개발 DB(127.0.0.1:5433)에 못 붙었다. 도커를 켜고(docker compose up -d postgres)"
    drop_db() { psql -h 127.0.0.1 -p 5433 -U platform -d postgres -qc "DROP DATABASE IF EXISTS $DB_NAME" >/dev/null 2>&1 || true; }
    trap drop_db EXIT
    # 역할은 서버에 하나라 「role already exists」가 나는 것이 정상이다
    for f in db/init/*.sql; do psql -h 127.0.0.1 -p 5433 -U platform -d "$DB_NAME" -q -f "$f" >/dev/null 2>&1 || true; done
    docker run --rm -v "$PWD/db:/db:ro" ghcr.io/amacneil/dbmate:2 \
      --url "postgres://platform:platform@host.docker.internal:5433/$DB_NAME?sslmode=disable" \
      --migrations-dir /db/migrations --no-dump-schema up >/dev/null \
      || fail "임시 DB 에 마이그레이션을 못 걸었다. 도커가 켜져 있는지 보고"
    export DATABASE_URL="postgres://platform:platform@127.0.0.1:5433/$DB_NAME"
    echo "[pre-push] 임시 DB $DB_NAME 에서 DB 검사도 돈다"
  fi
  # 바뀐 것과 이어진 검사만 돈다 (vitest --changed) + import 로 안 이어지는 검사(test:always).
  # migration · 설정이 바뀌면 전체다 — vitest 의 forceRerunTriggers 는 점 폴더(.claude/worktrees) 경로에서 안 걸린다
  if printf '%s\n' "$changed_all" | grep -qE '^(db/|package(-lock)?\.json$|vitest\.config\.|tsconfig)'; then
    npm test --silent || fail "테스트가 실패했다."
  else
    { npm run test:changed --silent -- origin/main && npm run test:always --silent; } || fail "테스트가 실패했다."
  fi
  # 하네스(훅·검사 스크립트)를 고쳤으면 그 검사도 돈다
  if printf '%s\n' "$changed_all" | grep -q '^\.claude/'; then
    npm run check:workflow --silent || fail "하네스 검사(.claude/scripts)가 실패했다."
  fi
fi

# --if-present 를 안 붙인다 — 케이스 차선의 유일한 규칙 검사라 스크립트가 사라지면 조용히 통과하지 말고 죽어야 한다
npm run check:tests --silent || fail "테스트 코드 규칙 위반 (SPEC §4 K표)."

echo "[pre-push] 통과"
